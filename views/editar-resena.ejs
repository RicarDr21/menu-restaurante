<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Editar reseña</title>
  <%- include('partials/styles') %>
</head>
<body>
  <%- include('partials/header') %>

  <main>
    <section class="detalle">
      <a href="/plato/<%= resena.platoId %>" class="volver">&larr; Volver al plato</a>

      <h2>Editar reseña</h2>

      <form action="/resena/<%= resena._id %>/editar" method="POST" class="form-resena">
        <label for="nombre">Tu nombre</label>
        <input type="text" id="nombre" name="nombre" value="<%= resena.nombre %>" required>

        <label for="calificacion">Calificación</label>
        <select id="calificacion" name="calificacion" required>
          <option value="5" <%= resena.calificacion === 5 ? 'selected' : '' %>>5 - Excelente</option>
          <option value="4" <%= resena.calificacion === 4 ? 'selected' : '' %>>4 - Muy bueno</option>
          <option value="3" <%= resena.calificacion === 3 ? 'selected' : '' %>>3 - Bueno</option>
          <option value="2" <%= resena.calificacion === 2 ? 'selected' : '' %>>2 - Regular</option>
          <option value="1" <%= resena.calificacion === 1 ? 'selected' : '' %>>1 - Malo</option>
        </select>

        <label for="comentario">Comentario</label>
        <textarea id="comentario" name="comentario" required><%= resena.comentario %></textarea>

        <button type="submit">Guardar cambios</button>
      </form>
    </section>
  </main>

  <%- include('partials/footer') %>
</body>
</html>