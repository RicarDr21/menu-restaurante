<%- include('partials/header') %>

<section class="listado">
  <h2>Nuestro Menú</h2>
  <div class="grid">
    <% platos.forEach(plato => { %>
      <article class="plato-card">
        <h3><%= plato.nombre %></h3>
        <p class="categoria"><%= plato.categoria %></p>
        <p class="precio">$<%= plato.precio.toLocaleString('es-CO') %></p>
        <a href="/plato/<%= plato.id %>">Ver detalle</a>
      </article>
    <% }) %>
  </div>
</section>

<style>
  .listado h2 { margin-bottom: 1.5rem; color: #8b3a3a; }
  .grid { display: flex; flex-wrap: wrap; gap: 1.5rem; }
  .plato-card { background: white; border-radius: 10px; padding: 1.5rem; width: 250px; box-shadow: 0 2px 6px rgba(0,0,0,0.1); }
  .plato-card h3 { margin-bottom: 0.3rem; }
  .categoria { color: #888; font-size: 0.85rem; margin-bottom: 0.5rem; }
  .precio { font-weight: bold; color: #8b3a3a; margin-bottom: 1rem; }
  .plato-card a { display: inline-block; background: #8b3a3a; color: white; text-decoration: none; padding: 0.5rem 1rem; border-radius: 6px; font-size: 0.9rem; }
</style>

<%- include('partials/footer') %>