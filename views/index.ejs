<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Menu Restaurante</title>
  <%- include('partials/styles') %>
</head>
<body>
  <%- include('partials/header') %>

  <main>
    <section class="listado">
      <h2>Nuestro Menú</h2>
      <div class="grid">
        <% platos.forEach(plato => { %>
          <article class="plato-card">
            <h3><%= plato.nombre %></h3>
            <p class="categoria"><%= plato.categoria %></p>
            <p class="precio">$<%= plato.precio.toLocaleString('es-CO') %></p>
            <a href="/plato/<%= plato.id %>">Ver detalle</a>
          </article>
        <% }) %>
      </div>
    </section>
  </main>

  <%- include('partials/footer') %>
</body>
</html>